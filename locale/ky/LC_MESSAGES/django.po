msgid "Подтвердите email на ProfLens"
msgstr "ProfLens сайтында email дарегиңизди ырастаңыз"

#, python-format
msgid ""
"Здравствуйте! Чтобы подтвердить email, откройте ссылку:\n"
"\n"
"%(link)s\n"
"\n"
