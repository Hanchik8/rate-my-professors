msgid "Узнайте, какие занятия на самом деле — до записи на курс."
msgstr "Сабактар чындыгында кандай өтөрүн — жазылуудан мурда билип алыңыз."

msgid "Имя преподавателя или кафедра"
msgstr "Окутуучунун аты же кафедра"

msgid "Город"
msgstr "Шаар"

msgid "Все города"
msgstr "Бардык шаарлар"

