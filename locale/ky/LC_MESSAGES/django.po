msgstr "пайдалуулары биринчи"

msgid "Пойду снова."
msgstr "Кайра барам."

msgid "Не пойду снова."
msgstr "Кайра барбайм."

msgid "Оценка:"
msgstr "Баасы:"

msgid "Полезно"
msgstr "Пайдалуу"

msgid "Бесполезно"
msgstr "Пайдасыз"

msgid "Пожаловаться"
msgstr "Арыздануу"

msgid "Предмет"
msgstr "Предмет"

msgid "Например: Алгоритмы, Общая физика, Микроэкономика"
msgstr "Мисалы: Алгоритмдер, Жалпы физика, Микроэкономика"

msgid "Семестр"
msgstr "Семестр"

msgid "Например: Осень 2025 или Весна 2025"
msgstr "Мисалы: Күз 2025 же Жаз 2025"

msgid "Общее качество (5 — лучше всего)"
msgstr "Жалпы сапат (5 — эң жакшы)"

msgid "Сложность (5 — очень сложно)"
msgstr "Татаалдыгы (5 — эң татаал)"

msgid "Да"
msgstr "Ооба"

msgid "Нет"
msgstr "Жок"

msgid "Пошли бы снова к этому преподавателю?"
msgstr "Бул окутуучуга кайра бармак белеңиз?"

msgid "Предпочитаю не указывать"
msgstr "Көрсөтпөйм"

msgid "Полученная оценка"
msgstr "Алган баа"

msgid "Теги"
msgstr "Тегдер"

msgid "Выберите до 3"
msgstr "3кө чейин тандаңыз"

msgid "Ваш отзыв"
msgstr "Сиздин сын-пикириңиз"

msgid "Не менее 20 символов. Пишите только об учёбе, без оскорблений и личных данных."
msgstr "Кеминде 20 белги. Окуу жөнүндө гана жазыңыз, кемсинтпей жана жеке маалыматсыз."

msgid "Выберите не более 3 тегов."
msgstr "3төн ашык тег тандабаңыз."

msgid "Имя"
msgstr "Аты"

msgid "Фамилия"
msgstr "Фамилиясы"

msgid "Кафедра"
msgstr "Кафедра"

msgid "Должность"
msgstr "Кызматы"

msgid "профессор"
msgstr "профессор"

msgid "доцент"
msgstr "доцент"

msgid "старший преподаватель"
msgstr "ага окутуучу"

msgid "преподаватель"
msgstr "окутуучу"

msgid "Строго оценивает"
msgstr "Катуу баалайт"

msgid "Понятные критерии"
msgstr "Түшүнүктүү критерийлер"

msgid "Интересные лекции"
msgstr "Кызыктуу лекциялар"

msgid "Много домашних заданий"
msgstr "Көп үй тапшырмасы"

msgid "Много тестов"
msgstr "Көп тест"

msgid "Групповые проекты"
msgstr "Топтук долбоорлор"

msgid "Доступен вне занятий"
msgstr "Сабактан тышкары жеткиликтүү"

msgid "Даёт полезную обратную связь"
msgstr "Пайдалуу кайтарым байланыш берет"

msgid "Важна посещаемость"
msgstr "Каттоо маанилүү"

msgid "Вдохновляет"
msgstr "Шыктандырат"

msgid "Зачёт"
msgstr "Зачёт"

msgid "Незачёт"
msgstr "Незачёт"

msgid "Ещё не знаю"
msgstr "Азырынча билбейм"

msgid "Правила"
msgstr "Эрежелер"

msgid "Добавить преподавателя"
msgstr "Окутуучу кошуу"

msgid "Выйти"
msgstr "Чыгуу"

msgid "Вход"
msgstr "Кирүү"

msgid "Регистрация"
msgstr "Катталуу"

msgid "Язык"
msgstr "Тил"

msgid "Демо-данные сбрасываются при рестарте (memory-режим)."
msgstr "Демо-дайындар кайра жүктөөдө тазарат (memory режими)."

msgid "Отзыв появится после проверки модератором."
msgstr "Сын-пикир модератор текшергенден кийин чыгат."

msgid "Чтобы оставить отзыв,"
msgstr "Сын-пикир калтыруу үчүн,"

msgid "войдите"
msgstr "кириңиз"

msgid "или"
msgstr "же"

msgid "зарегистрируйтесь"
msgstr "катталыңыз"

msgid "Отправить на модерацию"
msgstr "Модерацияга жөнөтүү"

msgid "Отмена"
msgstr "Жокко чыгаруу"

msgid "Преподавателей"
msgstr "Окутуучулар"

msgid "Средний рейтинг"
msgstr "Орточо рейтинг"

msgid "Пока нет кафедр."
msgstr "Азырынча кафедра жок."

msgid "Преподаватели"
msgstr "Окутуучулар"

msgid "Пока нет преподавателей."
msgstr "Азырынча окутуучулар жок."

msgid "Новый преподаватель появится после проверки модератором. Дубликаты по ФИО+вуз не принимаются."
msgstr "Жаңы окутуучу модератор текшергенден кийин чыгат. Аты-жөнү+ЖОЖ кайталанмасы кабыл алынбайт."

msgid "Чтобы добавить преподавателя,"
msgstr "Окутуучу кошуу үчүн,"

msgid "Нет аккаунта? Зарегистрируйтесь"
msgstr "Аккаунтуңуз жокпу? Катталыңыз"

msgid "Уже есть аккаунт? Войдите"
msgstr "Аккаунтуңуз барбы? Кириңиз"

msgid "Войти"
msgstr "Кирүү"

msgid "Зарегистрироваться"
msgstr "Катталуу"

msgid "Email"
msgstr "Email"

msgid "Пароль"
msgstr "Сырсөз"

msgid "Повторите пароль"
msgstr "Сырсөздү кайталаңыз"

msgid "Пользователь с таким email уже существует."
msgstr "Мындай email менен колдонуучу бар."

msgid "Пароли не совпадают."
msgstr "Сырсөздөр дал келбейт."

msgid "Пароль должен быть не менее 8 символов."
msgstr "Сырсөз кеминде 8 белгиден турушу керек."

msgid "Вы уже оставляли отзыв для этого предмета у этого преподавателя."
msgstr "Бул окутуучуга бул предмет боюнча сын-пикир калтыргансыз."

msgid "Отзыв отправлен на модерацию. Спасибо!"
msgstr "Сын-пикир модерацияга жөнөтүлдү. Рахмат!"

msgid "Вы уже голосовали за этот отзыв."
msgstr "Бул сын-пикирге добуш бергенсиз."

msgid "Жалоба отправлена модератору."
msgstr "Арыз модераторго жөнөтүлдү."

msgid "Регистрация выполнена. Добро пожаловать!"
msgstr "Катталуу аяктады. Кош келиңиз!"

msgid "Преподаватель с таким ФИО уже есть в этом вузе."
msgstr "Мындай аты-жөнү менен окутуучу бул ЖОЖдо бар."

msgid "Преподаватель отправлен на модерацию."
msgstr "Окутуучу модерацияга жөнөтүлдү."

msgid "Только об учёбе — без оскорблений, угроз, дискриминации."
msgstr "Окуу жөнүндө гана — кемсинтүү, коркутуу, басмырлоосуз."

msgid "Без личных данных: не публикуйте телефоны, адреса, фото, переписку."
msgstr "Жеке маалыматсыз: телефон, дарек, сүрөт, каттарды жарыялабаңыз."

msgid "Пишите честно и по делу — отзыв должен помочь другим студентам."
msgstr "Чын жана так жазыңыз — сын-пикир башка студенттерге жардам бериши керек."

msgid "Отзывы о реальных людях — зона риска (закон КР о персональных данных). Всё, что нарушает закон или правила, будет скрыто."
msgstr "Чыныгы адамдар жөнүндө сын-пикир — тобокелдик (КР жеке маалымат мыйзамы). Мыйзам же эреже бузган баары жашырылат."

msgid "Отзывы и новые преподаватели проходят модерацию перед публикацией."
msgstr "Сын-пикирлер жана жаңы окутуучулар жарыядан мурда модерациядан өтөт."

msgid "За нарушение — удаление отзыва и блокировка аккаунта."
msgstr "Эреже бузганда — сын-пикир өчүрүлөт, аккаунт бөгөттөлөт."

msgid "Увидели нарушение?"
msgstr "Эреже бузууну көрдүңүзбү?"

msgid "нажмите «Пожаловаться» под отзывом."
msgstr "сын-пикирдин алдындагы «Арыздануу» баскычын басыңыз."

msgid "Вузы"
msgstr "ЖОЖдор"

msgid "Все области"
msgstr "Бардык облустар"

msgid "Все типы"
msgstr "Бардык түрлөр"

msgid "Область"
msgstr "Облус"

msgid "Тип"
msgstr "Түрү"

msgid "Фильтр"
msgstr "Чыпка"

msgid "Сбросить"
msgstr "Тазалоо"

msgid "Ничего не нашлось."
msgstr "Эч нерсе табылган жок."

msgid "государственный"
msgstr "мамлекеттик"

msgid "частный"
msgstr "жеке"

msgid "Начните вводить название вуза..."
msgstr "ЖОЖдун атын жаза баштаңыз..."

msgid "Выберите вуз из списка"
msgstr "Тизмеден ЖОЖ тандаңыз"
