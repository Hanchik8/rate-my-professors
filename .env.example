# Local development. Copy to .env:  cp .env.example .env
DEBUG=True
# SECRET_KEY is optional while DEBUG=True
# memory = demo data in RAM (no database needed); django = real database
REPO_BACKEND=memory
# PostgreSQL (docker compose up -d starts one); empty = SQLite file db.sqlite3
# DATABASE_URL=postgres://proflens:proflens@localhost:5432/proflens
