# =========================================================
# Локальная разработка
# =========================================================
# Минимум для запуска на своей машине. DEBUG=True ослабляет
# все строгие prod-проверки (см. config/settings.py).
SECRET_KEY=dev-only-not-for-production-abcdef1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
REPO_BACKEND=memory
# Чтобы подключить Postgres локально — раскомментируйте и поднимите
# docker compose up -d:
# DATABASE_URL=postgres://proflens:proflens@localhost:5432/proflens
# REPO_BACKEND=django
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.kg
# Адрес поддержки на /privacy/. В dev можно не задавать — тогда абзац скрыт.
# CONTACT_EMAIL=support@example.kg

# =========================================================
# Production
# =========================================================
# Обязательные переменные при DEBUG=False (иначе manage.py check
# и запуск приложения падают с ImproperlyConfigured — см.
# config/settings.py, раздел "Strict fail-safe"):
#
# SECRET_KEY=<50+ символов, из них минимум 5 различных>
# DEBUG=False
# ALLOWED_HOSTS=example.kg,www.example.kg
# DATABASE_URL=postgres://user:pass@host:5432/dbname   # SQLite в проде запрещён
# REPO_BACKEND=django
# ADMIN_URL=admin-CHANGE-ME-123/                        # путь не должен быть "admin/"
# CONTACT_EMAIL=support@example.kg                      # адрес поддержки на странице /privacy/
#
# Остальные переменные production-окружения:
#
# REDIS_URL=redis://127.0.0.1:6379/0
# TRUSTED_PROXY_COUNT=1                                 # число доверенных reverse-proxy перед приложением
# CSRF_TRUSTED_ORIGINS=https://example.kg,https://www.example.kg
# SECURE_SSL_REDIRECT=True
# SECURE_PROXY_SSL_HEADER=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@example.kg
# EMAIL_HOST=smtp.example.kg
# EMAIL_PORT=587
# EMAIL_HOST_USER=noreply@example.kg
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
