SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
# Comma-separated HTTPS origins trusted for CSRF (production only; empty is fine for local dev).
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://proflens:proflens@localhost:5432/proflens
REPO_BACKEND=memory

# Security hardening (defaults track DEBUG: enabled when DEBUG=False).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_REFERRER_POLICY=same-origin

# Rate limiting (cache-backed fixed windows). Use a shared cache in production.
RATELIMIT_ENABLE=True
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=proflens

# Email (signup confirmation codes, password reset). Free default: Gmail SMTP.
# EMAIL_HOST_USER is your Gmail address, EMAIL_HOST_PASSWORD a 16-character Google
# app password (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# New accounts must confirm their email with a 6-digit code. Set to False while
# SMTP is not configured; new accounts are then activated immediately.
REQUIRE_EMAIL_VERIFICATION=True
