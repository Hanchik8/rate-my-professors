# Production settings for docker-compose.prod.yml. Copy to .env.prod and fill in.
# NEVER commit .env.prod to git.

DEBUG=False
# generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# your domain(s), comma separated
ALLOWED_HOSTS=proflens.kg,www.proflens.kg
CSRF_TRUSTED_ORIGINS=https://proflens.kg,https://www.proflens.kg
SITE_URL=https://proflens.kg
# used by the Caddy (https) profile to get a certificate
DOMAIN=proflens.kg

# database password (any long random string)
POSTGRES_PASSWORD=
POSTGRES_USER=proflens
POSTGRES_DB=proflens
REPO_BACKEND=django

# how many proxies are in front of gunicorn: 1 with Caddy or a hosting load balancer, 0 if none
TRUSTED_PROXY_COUNT=1
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# admin on a hidden path, e.g. manage-7f3k2/
ADMIN_URL=admin/

# Email (for confirmation letters). Without EMAIL_HOST letters go to the log only.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ProfLens <noreply@proflens.kg>
# turn on after SMTP works: only confirmed users can post
REQUIRE_EMAIL_VERIFICATION=False

# performance tuning (defaults are fine for 2-4 CPU)
# WEB_CONCURRENCY=5
# GUNICORN_THREADS=4
# READ_CACHE_SECONDS=60
